# Copy to .env and insert your upstream key locally. Never commit .env.
AM2OAIR_RELAY_API_KEY=
AM2OAIR_RELAY_BASE_URL=https://api.poixe.com/v1
# Verified with Poixe: the unprefixed model works. Override for other providers.
AM2OAIR_RELAY_MODEL=claude-opus-5-5
AM2OAIR_RELAY_DATABASE_URL=sqlite:////data/relay.db
# Estimated costs: enter your provider's actual rates per 1,000,000 tokens.
# Empty means unknown, NOT free. Set 0 explicitly only for a genuinely free rate.
AM2OAIR_RELAY_COST_CURRENCY=USD
AM2OAIR_RELAY_COST_INPUT_PER_MILLION=
AM2OAIR_RELAY_COST_OUTPUT_PER_MILLION=
AM2OAIR_RELAY_COST_CACHE_READ_PER_MILLION=
# Generic write rate is used when upstream reports no cache TTL breakdown.
AM2OAIR_RELAY_COST_CACHE_WRITE_PER_MILLION=
AM2OAIR_RELAY_COST_CACHE_WRITE_5M_PER_MILLION=
AM2OAIR_RELAY_COST_CACHE_WRITE_1H_PER_MILLION=
